# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/sbg-buk-quiz

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, type: Web)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers (either or both)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Redis (Socket.IO adapter for multi-instance deployments)
REDIS_URL=
