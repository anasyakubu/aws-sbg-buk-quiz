# Server
PORT=5000
NODE_ENV=development

# Public origin of this API. Leave blank locally; set on Vercel to e.g.
# https://sbg-buk-quiz-api.vercel.app (used to build the Google callback URL).
SERVER_URL=

# Allowed client origin(s), comma-separated. The first one is used for OAuth redirects.
# e.g. https://sbg-buk-quiz.vercel.app,https://sbg-buk-quiz-git-dev-you.vercel.app
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas in production — network access must allow 0.0.0.0/0 for Vercel)
MONGODB_URI=mongodb://localhost:27017/sbg-buk-quiz

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, type: Web)
# Authorized redirect URI (local): http://localhost:5000/api/auth/google/callback
# Authorized redirect URI (prod):  https://<your-api-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers (either or both)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
