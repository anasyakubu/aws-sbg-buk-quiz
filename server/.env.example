# Server
PORT=5000
NODE_ENV=development

# Public HTTPS origin of your Vercel API project.
# Leave blank locally. Used to build the Google OAuth callback URL.
SERVER_URL=

# Allowed web app origins, comma-separated. First one used for OAuth redirects.
# e.g. https://your-quiz.vercel.app,https://quiz.yourdomain.com
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas in production — allow access from your server host)
MONGODB_URI=mongodb://localhost:27017/sbg-buk-quiz

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, type: Web)
# Authorized redirect URI (local): http://localhost:5000/api/auth/google/callback
# Authorized redirect URI (prod):  https://<your-api-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers (either or both)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
